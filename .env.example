# ============================================================
# EDU-SHARE — environment template (M3 foundation)
# Copy to .env for local development:  cp .env.example .env
# NEVER commit a real .env file. All values below are placeholders.
# ============================================================

# PostgreSQL connection string (local Docker default).
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/edushare

# Direct (non-pooled) connection for migrations. Optional; falls back to DATABASE_URL.
# Used against Supabase ("Transaction" pooler in DATABASE_URL + "Session"/direct in DIRECT_URL).
DIRECT_URL=postgres://postgres:postgres@127.0.0.1:5432/edushare

# Public Supabase project URL (safe to expose to the browser when set).
# Example: https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anonymous key (safe to expose to the browser when set).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this app (used for health checks, links, and callbacks).
APP_URL=http://localhost:3000

# Node environment: development | test | production
NODE_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info
