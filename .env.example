# ============================================================
# EDU-SHARE — environment template (M3 foundation)
# Copy to .env for local development:  cp .env.example .env
# NEVER commit a real .env file. All values below are placeholders.
# ============================================================

# PostgreSQL connection string (local Docker default).
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/edushare

# Direct (non-pooled) connection for migrations. Optional; falls back to DATABASE_URL.
# Used against Supabase ("Transaction" pooler in DATABASE_URL + "Session"/direct in DIRECT_URL).
DIRECT_URL=postgres://postgres:postgres@127.0.0.1:5432/edushare

# Public Supabase project URL (safe to expose to the browser when set).
# Example: https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anonymous key (safe to expose to the browser when set).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this app (used for health checks, links, and callbacks).
APP_URL=http://localhost:3000

# Node environment: development | test | production
NODE_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ------------------------------------------------------------------
# M4 — resource storage
# ------------------------------------------------------------------
# Private Supabase Storage bucket that holds uploaded files. Leave EMPTY until the
# bucket exists: uploads are then refused with an explanation rather than being
# written somewhere unexpected. The bucket must be private; the app only ever issues
# short-lived signed URLs (60 s) to the signed-in user. No service-role key is used.
SUPABASE_STORAGE_BUCKET=

# ------------------------------------------------------------------
# M4 — development-only switches (never valid with NODE_ENV=production)
# ------------------------------------------------------------------
# The environment validator refuses to boot if either of these is "1" while
# NODE_ENV=production. There is no override and no bypass flag.
#
# "1" enables the local identity adapter: sign in with any name and email, no
# password, no account, sessions live in the dev server process only.
# Use it to exercise ownership, RLS and uploads before Supabase Auth exists.
EDU_SHARE_DEV_AUTH=0

# "1" enables the local filesystem storage adapter (writes under .local/storage,
# which is git-ignored). It survives a dev-server restart but is not durable storage
# and is not shared between machines.
EDU_SHARE_LOCAL_STORAGE=0
