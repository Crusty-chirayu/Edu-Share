{
  "name": "edu-share-platform",
  "version": "0.1.0",
  "private": true,
  "description": "EDU-SHARE academic resource discovery and sharing platform (M3 foundation).",
  "license": "MIT",
  "engines": {
    "node": ">=20 <25"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx ./scripts/migrate.ts up",
    "db:migrate:down": "tsx ./scripts/migrate.ts down",
    "db:migrate:status": "tsx ./scripts/migrate.ts status",
    "db:seed": "tsx ./scripts/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "dotenv": "16.4.5",
    "drizzle-orm": "0.36.4",
    "next": "15.5.2",
    "postgres": "3.4.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "22.18.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@typescript-eslint/eslint-plugin": "8.44.0",
    "@typescript-eslint/parser": "8.44.0",
    "drizzle-kit": "0.31.4",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.2",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
